@model EducationalPlatform.Models.ViewModels.Certificate.CertificateViewModel?
@{
    ViewData["Title"] = "Verify Certificate";
}

<section class="section-top">
    <div class="container">
        <div class="col-lg-10 offset-lg-1 text-center">
            <div class="section-top-title">
                <h1>Verify a Certificate</h1>
            </div>
        </div>
    </div>
</section>

<section class="section-padding">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <form method="get" class="mb-4">
                    <div class="input-group">
                        <input type="text" name="code" class="form-control" placeholder="Enter certificate code" value="@Context.Request.Query["code"]" />
                        <button type="submit" class="btn_one">Verify</button>
                    </div>
                </form>

                @if (Context.Request.Query.ContainsKey("code"))
                {
                    if (Model != null)
                    {
                        <div class="alert alert-success">
                            <h5>✅ Valid Certificate</h5>
                            <p class="mb-1"><strong>Student:</strong> @Model.StudentName</p>
                            <p class="mb-1"><strong>Course:</strong> @Model.CourseTitle</p>
                            <p class="mb-1"><strong>Instructor:</strong> @Model.InstructorName</p>
                            <p class="mb-0"><strong>Issued:</strong> @Model.IssuedAt.ToString("MMMM dd, yyyy")</p>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-danger">❌ No certificate found with that code.</div>
                    }
                }
            </div>
        </div>
    </div>
</section>
