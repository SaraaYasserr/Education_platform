@model List<CourseListItemViewModel>
@{
    ViewData["Title"] = "Home";
}

<!-- START HOME -->
<section class="home_bg hb_height" style="background-image: url(/assets/img/bg/home-bg.jpg); background-size:cover; background-position: center center;">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 col-sm-12 col-xs-12">
                <div class="hero-text ht_top">
                    <h1><span>Smart Study</span> Where Knowledge Meets the Web</h1>
                    <p>Learn new skills, advance your career, and grow with courses taught by real instructors on our platform.</p>
                </div>
                <div class="home_sb">
                    <form asp-controller="Course" asp-action="Index" method="get" class="banner_subs">
                        <input type="text" name="SearchTerm" class="form-control home_si" placeholder="Search your course here">
                        <button type="submit" class="subscribe__btn">Search <i class="fa fa-paper-plane-o"></i></button>
                    </form>
                </div>
            </div>
            <div class="col-lg-6 col-sm-12 col-xs-12">
                <div class="hero-text-img">
                    <img src="~/assets/img/home-img2.png" class="img-fluid" alt="Students learning" />

                </div>
            </div>
        </div>
    </div>
</section>
<!-- END HOME -->
<!-- START FEATURED COURSES -->
<section class="course_area section-padding">
    <div class="container">
        <div class="section-title text-center">
            <h2>Our Popular Courses</h2>
            <p>Explore our most popular courses, taught by experienced instructors across a range of categories.</p>
        </div>
        <div class="row">
            @if (Model.Any())
            {
                foreach (var course in Model)
                {
                    @await Html.PartialAsync("Partials/_CourseCard", course)
                }
            }
            else
            {
                <div class="col-12 text-center">
                    <p>No courses are available yet. Check back soon!</p>
                </div>
            }
        </div>
        <div class="text-center mt-4">
            <a asp-controller="Course" asp-action="Index" class="btn_one">View All Courses</a>
        </div>
    </div>
</section>
<!-- END FEATURED COURSES -->
<!-- START TEAM -->
<section class="team_area section-padding">
    <div class="container">
        <div class="section-title text-center">
            <h2>Meet our Instructors</h2>
            <div class="container">
                <div class="row">
                    <div class="col-lg-12 vp_top">
                        <div class="video-area" style="background-image: url(/assets/img/Teacher_Studen.jpg); background-size:cover; background-position: center center;">
                        </div>
                    </div>
                </div>
            </div>
            <p>Learn from experienced instructors who are passionate about helping you grow.</p>
        </div>
        <div class="text-center">
            <a asp-controller="Instructor" asp-action="Index" class="btn_one">Meet All Our Instructors</a>
        </div>
    </div>
</section>
<!-- END TEAM -->
