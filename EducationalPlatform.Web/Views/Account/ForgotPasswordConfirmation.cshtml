@{
    ViewData["Title"] = "Check Your Email";
}

<section class="section-top">
    <div class="container">
        <div class="col-lg-10 offset-lg-1 text-center">
            <div class="section-top-title">
                <h1>Reset Link Generated</h1>
            </div>
        </div>
    </div>
</section>

<section class="section-padding text-center">
    <div class="container">
        <p>If an account with that email exists, a password reset link has been generated.</p>

        @if (ViewBag.ResetUrl != null)
        {
            <div class="alert alert-info d-inline-block text-start" style="max-width:600px;">
                <strong>Graduation project note:</strong> no email server is configured, so here is your reset link directly
                (in production this would be emailed instead):
                <br />
                <a href="@ViewBag.ResetUrl">@ViewBag.ResetUrl</a>
            </div>
        }

        <p class="mt-4"><a asp-controller="Account" asp-action="Login" class="btn_one">Back to Sign In</a></p>
    </div>
</section>
