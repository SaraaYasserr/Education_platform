@model ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<section class="section-top">
    <div class="container">
        <div class="col-lg-10 offset-lg-1 text-center">
            <div class="section-top-title">
                <h1>My Profile</h1>
            </div>
        </div>
    </div>
</section>

<section class="section-padding">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7">
                <div class="text-center mb-4">
                    <img src="@(string.IsNullOrEmpty(Model.ProfileImage) ? "/assets/img/team/team1.jpg" : Model.ProfileImage)"
                         class="rounded-circle" width="100" height="100" style="object-fit:cover;" alt="@Model.FullName" />
                    <p class="mt-2 mb-0"><strong>@Model.FullName</strong></p>
                    <span class="text-muted">@Model.Role</span>
                </div>

                <form asp-controller="Account" asp-action="Profile" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ProfileImage" />
                    <input type="hidden" asp-for="Role" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-group mb-3">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label">Email</label>
                        <input value="@Model.Email" class="form-control" disabled />
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <input asp-for="PhoneNumber" class="form-control" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label for="profileImageFile" class="form-label">New Profile Image</label>
                        <input id="profileImageFile" name="profileImageFile" type="file" accept="image/*" class="form-control" />
                    </div>

                    <button type="submit" class="btn_one">Save Changes</button>
                    <a asp-controller="Account" asp-action="ChangePassword" class="btn_two ms-2">Change Password</a>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
