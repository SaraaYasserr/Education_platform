@model SubscriptionPlanEditViewModel
@{
    ViewData["Title"] = "Create Plan";
}

<section class="section-top">
    <div class="container">
        <div class="col-lg-10 offset-lg-1 text-center">
            <div class="section-top-title">
                <h1>Create Subscription Plan</h1>
            </div>
        </div>
    </div>
</section>

<section class="section-padding">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <form asp-controller="Membership" asp-action="CreatePlan" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-group mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 form-group mb-3">
                            <label asp-for="Price" class="form-label"></label>
                            <input asp-for="Price" class="form-control" />
                            <span asp-validation-for="Price" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 form-group mb-3">
                            <label asp-for="DurationInDays" class="form-label"></label>
                            <input asp-for="DurationInDays" class="form-control" />
                            <span asp-validation-for="DurationInDays" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Features" class="form-label"></label>
                        <textarea asp-for="Features" rows="5" class="form-control" placeholder="One feature per line"></textarea>
                        <span asp-validation-for="Features" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="IsFeatured" class="form-check-input" />
                        <label asp-for="IsFeatured" class="form-check-label"></label>
                    </div>

                    <button type="submit" class="btn_one">Create Plan</button>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
