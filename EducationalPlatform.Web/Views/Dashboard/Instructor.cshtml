@model InstructorDashboardViewModel
@{
    ViewData["Title"] = "Instructor Dashboard";
}

<section class="section-top">
    <div class="container">
        <div class="col-lg-10 offset-lg-1 text-center">
            <div class="section-top-title">
                <h1>Instructor Dashboard</h1>
            </div>
        </div>
    </div>
</section>

<section class="section-padding">
    <div class="container">
        <div class="row">
            <div class="col-lg-3 col-sm-6">
                <div class="dashboard-stat-card">
                    <h3>@Model.TotalCourses</h3>
                    <span>My Courses</span>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6">
                <div class="dashboard-stat-card">
                    <h3>@Model.TotalStudents</h3>
                    <span>Students Taught</span>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6">
                <div class="dashboard-stat-card">
                    <h3>@Model.TotalLessons</h3>
                    <span>Total Lessons</span>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6">
                <div class="dashboard-stat-card">
                    <h3>@Model.AverageRating.ToString("0.0")</h3>
                    <span>Average Rating</span>
                </div>
            </div>
        </div>

        <div class="mb-4">
            <a asp-controller="Course" asp-action="MyCourses" class="btn_one">Manage My Courses</a>
            <a asp-controller="Course" asp-action="Create" class="btn_two ms-2">+ New Course</a>
        </div>

        <div class="row">
            <div class="col-lg-6">
                <h4>My Courses</h4>
                @if (Model.MyCourses.Any())
                {
                    <table class="table">
                        <thead><tr><th>Course</th><th>Enrolled</th><th>Rating</th></tr></thead>
                        <tbody>
                            @foreach (var c in Model.MyCourses)
                            {
                                <tr>
                                    <td><a asp-controller="Course" asp-action="Details" asp-route-id="@c.CourseId">@c.Title</a></td>
                                    <td>@c.EnrollmentCount</td>
                                    <td>@c.AverageRating.ToString("0.0")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted">You haven't created any courses yet.</p>
                }
            </div>
            <div class="col-lg-6">
                <h4>Recent Students</h4>
                @if (Model.RecentStudents.Any())
                {
                    <table class="table">
                        <thead><tr><th>Student</th><th>Course</th><th>Date</th></tr></thead>
                        <tbody>
                            @foreach (var e in Model.RecentStudents)
                            {
                                <tr>
                                    <td>@e.StudentName</td>
                                    <td>@e.CourseTitle</td>
                                    <td>@e.EnrollmentDate.ToString("MMM dd")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted">No students enrolled yet.</p>
                }
            </div>
        </div>
    </div>
</section>
